# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=audit_dashboard

# LLM API Keys (set whichever you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default LLM provider and model
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-opus-4-6

# Whisper (uses OPENAI_API_KEY)
WHISPER_MODEL=whisper-1

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=audit-dashboard-files
R2_PUBLIC_URL=

# App
MAX_FILE_SIZE_MB=100
APP_SECRET_KEY=changeme-in-production
CORS_ORIGINS=http://localhost:5173

# Auth (single-user JWT)
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=168
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
